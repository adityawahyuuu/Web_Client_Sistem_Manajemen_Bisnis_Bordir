# Copy to .env.production and fill in real values before `docker build`.
# Vite bakes these into the JS bundle at build time (see Dockerfile) —
# changing them later requires rebuilding the web image, not just restarting it.

# API Configuration
VITE_API_BASE_URL=https://your-production-domain
VITE_API_PREFIX=/patchwork/api

# Web Routes Configuration
VITE_WEB_BASE_PATH=/patchwork/web
